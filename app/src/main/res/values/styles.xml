<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Reconstructed app theme. Original referenced @style/TailorGuideTheme with
         .NoTitle and .NoActionBar variants (parent was an AppCompat/Material theme). -->
    <style name="TailorGuideTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryDark">#303F9F</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <style name="TailorGuideTheme.NoTitle" parent="TailorGuideTheme">
        <item name="windowNoTitle">true</item>
    </style>

    <style name="TailorGuideTheme.NoActionBar" parent="TailorGuideTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
